# Tokens callers may send as `Authorization: Bearer <token>`. Several are allowed, comma separated.
# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
ROUTER_TOKENS=
# Optional named access tokens, additive to ROUTER_TOKENS. Clients send the token only.
# ROUTER_NAMED_TOKENS='{"eHub":"random-secret","studio":"another-random-secret"}'

# Model scores (free key from artificialanalysis.ai). Without it the last cached scores are used.
ARTIFICIAL_ANALYSIS_API_KEY=

# Only providers with a key are used; leave the others empty.
OPENROUTER_API_KEY=
OPENCODE_API_KEY=
GEMINI_API_KEY=
ZAI_API_KEY=
NVIDIA_API_KEY=
GROQ_API_KEY=

# LOG_LEVEL=INFO
