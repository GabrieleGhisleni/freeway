# systemd unit for the Raspberry Pi (Rust binary). The binary comes from deploy/deploy.sh (cross-compiled on the PC).
# Install:  sudo cp deploy/freeway-rust.service /etc/systemd/system/freeway.service
#           sudo systemctl daemon-reload && sudo systemctl enable --now freeway
# Edit User and the two paths below if the project does not live in /home/pi/freeway.

[Unit]
Description=freeway (OpenAI-compatible router over free LLM providers)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/freeway
# Keys and tokens are read from /home/pi/freeway/.env (loaded by the app itself).
# Listens on 127.0.0.1 only: a Cloudflare Tunnel (cloudflared) or another proxy on this machine exposes it.
# Use 0.0.0.0 only on a trusted LAN or VPN (Tailscale).
ExecStart=/home/pi/freeway/freeway --host 127.0.0.1 --port 4100
Restart=always
RestartSec=5

# Memory cap (not measured, generous for a single static binary); it keeps a runaway from taking the whole board down.
MemoryMax=150M

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/home/pi/freeway/data

[Install]
WantedBy=multi-user.target
